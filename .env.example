# ---------------------------------------------------------------
# Lokal geliştirme: bu dosyayı .env.local olarak kopyala (git'e eklenmez)
# Railway deploy: Service → Variables → aynı isimlerle ekle
# ---------------------------------------------------------------

# Google Drive galeri (opsiyonel)
# Google Cloud Console → Drive API etkin → API key
# Klasör "Bağlantıya sahip olan herkes görüntüleyebilir" olmalı
GOOGLE_DRIVE_API_KEY=

# --- Backend (server/) ---
# Railway'de: ${{Postgres.DATABASE_URL}}  (Variable Reference)
# Lokalde:   Railway Postgres → Connect → "Public Network" URL'i
DATABASE_URL=

# Lokal API portu (Railway PORT'u kendisi verir)
PORT=4000

# Opsiyonel
# Frontend farklı domainde ise (örn. Vercel'de kalırsa) → https://binder.vercel.app
CLIENT_ORIGIN=
# Kullanıcı başına toplam resim kotası (MB)
MAX_USER_STORAGE_MB=300
# Oturum süresi (gün)
SESSION_TTL_DAYS=30
# İstatistik panelini görebilecek kullanıcı adları (virgülle, büyük/küçük harf duyarsız)
# Boş bırakılırsa panel kimseye görünmez; uygulama davranışı değişmez
ADMIN_USERNAMES=

# --- Frontend ---
# Yalnızca API farklı domainde ise (aynı origin'de boş bırak)
REACT_APP_API_URL=
